# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional. Ultra-fast sub-100ms LLM inference via Groq Llama 3.3 70B.
GROQ_API_KEY="gsk_MY_GROQ_API_KEY"
GROQ_API_KEY_SECONDARY="gsk_MY_SECONDARY_GROQ_API_KEY"

# APP_URL: The URL where this app is hosted (used for Agora LLM webhook).
APP_URL="http://localhost:3000"

# JWT Auth Secret Key
JWT_SECRET="vocalis_ai_jwt_secret_key_2026_super_secure_key"

# SMTP Mailer Configuration (for sending verification emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Vocalis AI Auth <noreply@vocalis.ai>"

# ── Agora Credentials (get these from console.agora.io) ──────────────────────
# VITE_ prefix exposes App ID to the client-side Agora RTC SDK (safe to expose)
VITE_AGORA_APP_ID="YOUR_AGORA_APP_ID"

# Server-side only — used for token generation + Conversational AI REST API
AGORA_APP_ID="YOUR_AGORA_APP_ID"
AGORA_APP_CERTIFICATE="YOUR_AGORA_APP_CERTIFICATE"

# Optional: Agora Conversational AI agent credentials (from console.agora.io → Voice Agent Builder)
# Required to enable full Conversational AI mode (agent handles STT + TTS natively in channel)
# Without these, app runs in RTC-transport mode (Agora for candidate audio, Gemini TTS for AI voice)
AGORA_CUSTOMER_KEY="YOUR_AGORA_CUSTOMER_KEY"
AGORA_CUSTOMER_SECRET="YOUR_AGORA_CUSTOMER_SECRET"

