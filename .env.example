# ==============================================================================
# Vocalis AI — Environment Configuration Template (.env)
# ==============================================================================

# ── Primary AI Intelligence & Deliberation ───────────────────────────────────
# GEMINI_API_KEY: Used for backstage multi-role panel deliberation, rubric scoring,
# dynamic difficulty calibration, and detailed PDF report generation.
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY"

# GROQ_API_KEY: Optional. Ultra-low latency (<100ms) LLM inference via Groq
# (Qwen 3.8 27B / Compound Mini: qwen/qwen3.8-27b) for real-time interview turns and rapid backchanneling.
GROQ_API_KEY="gsk_YOUR_PRIMARY_GROQ_API_KEY"
GROQ_API_KEY_SECONDARY="gsk_YOUR_SECONDARY_GROQ_API_KEY"

# APP_URL: Base URL where this app is hosted (used for Agora LLM webhooks & callbacks)
APP_URL="http://localhost:3000"

# ── Authentication & Security ────────────────────────────────────────────────
# JWT_SECRET: Strong secret key used to sign session auth tokens
JWT_SECRET="replace_with_a_secure_64_character_random_hex_or_secret"

# ── SMTP Mailer Configuration (for verification & OTP emails) ────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM="Vocalis AI Auth <noreply@vocalis.ai>"

# ── Agora Real-Time Audio Infrastructure (console.agora.io) ───────────────────
# VITE_ prefix exposes App ID to the frontend Agora Web RTC client
VITE_AGORA_APP_ID="YOUR_AGORA_APP_ID"

# Server-side RTC Token Generation & Channel Management
AGORA_APP_ID="YOUR_AGORA_APP_ID"
AGORA_APP_CERTIFICATE="YOUR_AGORA_APP_CERTIFICATE"

# ── Agora Conversational AI Agent Engine (Optional) ──────────────────────────
# Enables Server-Side Conversational AI Cloud Pipeline:
# Deepgram Nova-3 (ASR) -> Groq Qwen 3.8 27B (LLM) -> MiniMax (TTS) directly in SDRTN.
# When omitted, the platform runs in Hybrid Real-Time Mode (Client Agora RTC + Backend LLM/TTS).
AGORA_CUSTOMER_KEY="YOUR_AGORA_CUSTOMER_KEY"
AGORA_CUSTOMER_SECRET="YOUR_AGORA_CUSTOMER_SECRET"

# ── Interactive Photorealistic Avatar (Optional) ─────────────────────────────
# HeyGen Interactive Streaming Avatar integration.
# Streams live photorealistic interviewer video via WebRTC (powered by LiveKit client).
AGORA_AVATAR_VENDOR="heygen"
HEYGEN_API_KEY="YOUR_HEYGEN_API_KEY"
HEYGEN_AVATAR_ID="YOUR_HEYGEN_AVATAR_ID"
